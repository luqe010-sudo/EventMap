# Shared, non-secret engine configuration. Copy to common.env on the VPS.
# Production starts in pending_review (Etap 4/5); "publish" only after the owner approves quality criteria.
ENGINE_ENV=production
ENGINE_PUBLISH_MODE=pending_review
ENGINE_PUBLISH_DAILY_CAP=100
ENGINE_AUTOPUBLISH_MIN_SCORE=0.85
ENGINE_WORKER_CONCURRENCY=4
ENGINE_HOST_MIN_INTERVAL_MS=5000
ENGINE_USER_AGENT=MapaImprezBot/1.0 (+https://mapaimprez.pl/bot)

# Public Supabase reads (same values as the website; not secret).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=https://mapaimprez.pl

# Budget: hard ceilings from env; the owner sets actual limits in the panel (≤ ceilings).
# Default 0 PLN = no paid operations until the owner approves a budget.
ENGINE_BUDGET_CEILING_MONTHLY_PLN=300
ENGINE_BUDGET_CEILING_DAILY_PLN=20
ENGINE_BUDGET_MONTHLY_PLN=0
ENGINE_BUDGET_DAILY_PLN=0
ENGINE_INFRA_MONTHLY_PLN=0

# Geocoding: public Nominatim (≤1 req/s, attribution "© OpenStreetMap contributors").
ENGINE_NOMINATIM_URL=https://nominatim.openstreetmap.org

# Notifications (optional): ntfy topic URL, Discord/Slack webhook or a generic JSON webhook.
ENGINE_NOTIFY_WEBHOOK_URL=
ENGINE_NOTIFY_WEBHOOK_KIND=ntfy
