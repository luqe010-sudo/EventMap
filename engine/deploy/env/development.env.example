# Local development (Windows/macOS/Linux, Node 24, no Docker needed):
#   node --env-file=engine/deploy/env/development.env engine/src/main.ts run
ENGINE_ENV=development
ENGINE_ROLE=all
ENGINE_DATA_DIR=./engine/.data
ENGINE_PUBLISH_MODE=off
ENGINE_CONTROL_HOST=127.0.0.1
ENGINE_CONTROL_PORT=8787
# 32+ random characters; the same value goes to ENGINE_CONTROL_TOKEN in .env.local for the admin panel.
ENGINE_CONTROL_TOKEN=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
