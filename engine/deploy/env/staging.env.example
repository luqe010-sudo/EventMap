# Staging: same image, dry-run against production reads. No service key is mounted.
ENGINE_ENV=staging
ENGINE_PUBLISH_MODE=dry_run
ENGINE_PUBLISH_DAILY_CAP=0
ENGINE_WORKER_CONCURRENCY=2
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
ENGINE_BUDGET_CEILING_MONTHLY_PLN=0
ENGINE_BUDGET_CEILING_DAILY_PLN=0
